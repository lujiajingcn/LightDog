<?xml version="1.0"?>
<!--
  LightDog 充电底座（仿真）

  坐标系约定（重要，改几何前先读懂）：
    dock frame 原点 = 桩体中心在地面的投影
    +x = 朝外（朝向机器人来车方向）
    +y = 朝左
    +z = 向上

  机器人正对桩前进（dock_backwards: false），因此进入时机器人 yaw 与 dock yaw 相差 180°。

  三段式贴靠距离（docking_threshold 就按这些数调）：
    dock 原点 -> 后挡板前表面      0.080 m
    后挡板前表面 -> marker 板前表面 0.004 m
    marker 板前表面 -> 车头前缘     0.000 m（撞上即停）
    机器人在车头贴住时，base_link 到 dock 原点约 0.30 m
  所以 docking_threshold 取 0.32，控制器在物理接触前就判定到位，不会一直顶着桩推。

  全部几何 z_max = 0.225 m < 激光高度 0.2445 m —— 见 model.config 的说明。
-->
<sdf version="1.9">
  <model name="lightdog_dock">
    <static>true</static>

    <link name="dock_link">

      <!-- 底板：机器人可以直接压上来（2cm 台阶，四驱过得去） -->
      <collision name="base_collision">
        <pose>0 0 0.010 0 0 0</pose>
        <geometry><box><size>0.30 0.36 0.02</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.010 0 0 0</pose>
        <geometry><box><size>0.30 0.36 0.02</size></box></geometry>
        <material>
          <ambient>0.10 0.11 0.13 1</ambient>
          <diffuse>0.14 0.15 0.18 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- 两侧导向翼：给轮子一个「槽」，视觉上也像充电桩 -->
      <collision name="wing_l_collision">
        <pose>0.02 0.155 0.060 0 0 0</pose>
        <geometry><box><size>0.16 0.02 0.12</size></box></geometry>
      </collision>
      <visual name="wing_l_visual">
        <pose>0.02 0.155 0.060 0 0 0</pose>
        <geometry><box><size>0.16 0.02 0.12</size></box></geometry>
        <material>
          <ambient>0.85 0.62 0.05 1</ambient>
          <diffuse>0.95 0.70 0.06 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <collision name="wing_r_collision">
        <pose>0.02 -0.155 0.060 0 0 0</pose>
        <geometry><box><size>0.16 0.02 0.12</size></box></geometry>
      </collision>
      <visual name="wing_r_visual">
        <pose>0.02 -0.155 0.060 0 0 0</pose>
        <geometry><box><size>0.16 0.02 0.12</size></box></geometry>
        <material>
          <ambient>0.85 0.62 0.05 1</ambient>
          <diffuse>0.95 0.70 0.06 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <!-- 后挡板：既是车头的物理限位，也是 marker 的安装面 -->
      <collision name="back_collision">
        <pose>-0.10 0 0.105 0 0 0</pose>
        <geometry><box><size>0.04 0.36 0.21</size></box></geometry>
      </collision>
      <visual name="back_visual">
        <pose>-0.10 0 0.105 0 0 0</pose>
        <geometry><box><size>0.04 0.36 0.21</size></box></geometry>
        <material>
          <ambient>0.10 0.11 0.13 1</ambient>
          <diffuse>0.14 0.15 0.18 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!--
        ArUco 标记：DICT_4X4_50 id=0

        **为什么用几何拼而不是贴图**：PBR 的 albedo_map 走 model:// 解析，
        在 gz Harmonic 里对「运行时才出现的模型目录」会报
            Unable to find file with URI [model://lightdog_dock/materials/textures/aruco_0.png]
        而把同一个目录换成直接写 36 个 box 就完全没有这个失败点（软件渲染下
        也省掉了纹理采样）。materials/textures/aruco_0.png 留在仓库里是为了
        真机打印 —— 那份图与这里的位图逐格对应。

        位图（6x6，黑框 + 4x4 数据区，1=黑）：
            ######
            #.#..#
            ##.#.#
            ###..#
            ###.##
            ######
        所以做法是：白色底板 -> 黑色 6x6 底板 -> 把数据区里 8 个白格盖上去。
        （黑格 8 个，白格 8 个，比逐个画 16 格少一半实体。）

        cell = 0.014 m，黑框边长 6*0.014 = 0.084 m —— 与
        lightdog_aruco_dock 的 marker_length 参数必须一致。

        图像行 r 自上而下 -> dock z 由高到低；列 j 自左向右 -> dock y 由 - 到 +。
        y = (j - 2.5) * 0.014，z = 0.155 - (r - 2.5) * 0.014
      -->

      <!-- 白底板（同时充当 marker 的静默区，0.14 = 10 cell） -->
      <visual name="marker_plate">
        <pose>-0.0775 0 0.155 0 0 0</pose>
        <geometry><box><size>0.005 0.14 0.14</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.0 0.0 0.0 1</specular>
        </material>
      </visual>

      <!-- 黑色 6x6 底（0.084 = 6 cell） -->
      <visual name="marker_black">
        <pose>-0.0735 0 0.155 0 0 0</pose>
        <geometry><box><size>0.002 0.084 0.084</size></box></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.0 0.0 0.0 1</specular>
        </material>
      </visual>

      <!-- 数据区 8 个白格 -->
      <visual name="marker_w_r1c1">
        <pose>-0.0724 -0.021 0.176 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r1c3">
        <pose>-0.0724 0.007 0.176 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r1c4">
        <pose>-0.0724 0.021 0.176 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r2c2">
        <pose>-0.0724 -0.007 0.162 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r2c4">
        <pose>-0.0724 0.021 0.162 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r3c3">
        <pose>-0.0724 0.007 0.148 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r3c4">
        <pose>-0.0724 0.021 0.148 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="marker_w_r4c3">
        <pose>-0.0724 0.007 0.134 0 0 0</pose>
        <geometry><box><size>0.001 0.014 0.014</size></box></geometry>
        <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
