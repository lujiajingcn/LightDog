<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lightdog</name>
  <version>0.4.0</version>
  <description>
    LightDog 桌面陪伴机器人：LED 亮度控制、电池状态可视化，以及在 linorobot2 之上
    的 URDF / launch 覆盖层（不修改上游源码）。
  </description>
  <maintainer email="542873980@qq.com">lujiajing</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- dock_manager 用 nav2_msgs/DockRobot 与 UndockRobot。之前漏了这条，
       rosdep 装依赖时不会带上，真机上 docking 动作直接 import 失败。 -->
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>linorobot2_description</exec_depend>
  <exec_depend>linorobot2_gazebo</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
