# LightDog 仿真配置模板 —— 复制成同目录的 .env 再用：
#
#     cp sim/.env.example sim/.env
#     docker compose --env-file .env up -d
#
# 为什么入库的是这个 .example 而不是 .env：真正的 .env 会被填上 LIGHTDOG_TOKEN
# 之类的敏感值，已经从 .gitignore 起忽略；模板里所有值都保持可提交的默认/留空。

# 车型：2wd / 4wd / mecanum —— 决定 URDF 覆盖层与 LED 的 visual 索引
# 产品定义是四轮（每侧两驱），故用 4wd
ROBOT_BASE=4wd

# 基础镜像（I-001）：留空则用 docker-compose 里的默认 linorobot2:gazebo。
# 真机 / CI 想要可重现，就把它指到按 upstream.lock 的 UPSTREAM_COMMIT 打标签的
# 构建，或直接写 registry 的 @sha256: 摘要，避免「同一条 compose 跑出不同镜像」。
# 例：SIM_IMAGE=linorobot2:gazebo-f6b0bd0
SIM_IMAGE=

# Gazebo 世界
WORLD=turtlebot3_world

# 出生点
#
# 别用 (0.5, 0)：turtlebot3_world 地上铺了一组 3x3 的装饰圆柱（ros_symbol，
# 半径 0.15，坐标 x,y ∈ {-1.1, 0, 1.1}）。(0.5,0) 正前方 0.95m 处就是
# (1.1,0) 那根柱子，相机（装在车头前 0.065m）到柱面只有 0.29m，卡在 near
# clip 0.3 以内 —— 深度图整块 0、画面被柱子糊死，P2 的人体检测直接失效。
#
# y=0.5 这一带（y ∈ [0.3, 0.7]）从 x=-2.4 到 2.4 全程没有柱子，是场景里
# 唯一一条长直线走廊（见 docs/P2_person_follow.md 的占用图）。
SPAWN_X=-1.8
SPAWN_Y=0.5
# 出生朝向（弧度）。0 = 朝 +x，也就是朝走廊深处
SPAWN_YAW=0.0

# 充电底座的世界坐标（P3）
#
# 放在 y=0.5 走廊的 -x 端、朝 +x（正对机器人可能过来的方向）。
# 桩体总高压在 0.225m 以下，低于 4wd 的 2D 激光（离地 0.2445m），
# 所以 /scan 里看不到它 —— Nav2 collision_monitor 不会在贴靠时把车拦停，
# 但 Gazebo 的物理碰撞仍然生效（车头会真的抵住桩体）。
# 详见 lightdog/models/dock/model.sdf 的注释。
DOCK_X=-2.3
DOCK_Y=0.5
DOCK_YAW=0.0
# 桩原点沿桩 +x 到「机器人中心停靠位」的距离（米）。
# 桩的几何：后挡板前表面 0.080 + marker 板 0.004 + 车头前缘 0.2225 ≈ 0.3065，
# 取 0.30 让物理碰撞先于控制器判定发生。
# 改这个值要同步 lightdog/config/p3_params.yaml 的 approach_offset。
DOCK_APPROACH=0.30

# ROS_DOMAIN_ID
ROS_DOMAIN_ID=0

# 是否拉起 Gazebo 3D 窗口（1=开 / 0=关）
# 容器里 gz 只跑服务端；设 1 才会额外起 GUI 客户端，浏览器里才能看到车身与 LED。
# 软件渲染下 GUI 会吃掉一部分 CPU，只跑数据链路验证时可以设 0。
SHOW_GUI=1

# ---------------- P4 视频存储 + 手机互联 ----------------

# 容器启动时是否自动拉起录像 + 后端（1=开 / 0=关，关掉也能用 bash sim/p4.sh start）
# 默认开：录像本身是产品的一部分，仿真里也应该一直在跑。
ENABLE_P4=1

# 后端访问令牌。留空 = 不鉴权。
# **真机部署必须设置**（在 .env 里设，别提交到仓库），否则同一个 WiFi 下任何人打开
# http://机器人IP:8000/ 都能看到摄像头画面。仿真里留空只是为了少一步。
# 例：LIGHTDOG_TOKEN=change-me-please
LIGHTDOG_TOKEN=

# ---------------- P5 跌倒检测 + 告警链路 ----------------

# 容器启动时是否自动拉起跌倒检测 + 告警状态机（1=开 / 0=关）
# 默认开：仿真里没有"人"时检测器只是持续报 absent，代价可以忽略；
# 一旦用 bash sim/p5.sh stand|fall 把人摆好，整条链路立刻就是活的。
ENABLE_P5=1
